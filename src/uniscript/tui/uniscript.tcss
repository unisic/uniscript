/* Palety siedza w app.py (DARK_THEME, LIGHT_THEME) i przenosza Tokyo Night.
   Tutaj tylko uklad; wszystkie kolory przez zmienne motywu, zeby jasna paleta
   dzialala z tego samego arkusza. */

Screen {
    background: $background;
}

/* Gorny pasek: marka, szukanie, licznik dopasowan, wykryty system. */

#topbar {
    height: 1;
    background: $panel;
}

#brand {
    width: auto;
    padding: 0 2 0 1;
    color: $foreground;
    text-style: bold;
}

#search {
    width: 1fr;
    height: 1;
    padding: 0 1;
    border: none;
    background: $background;
    color: $foreground;
}

#search:focus {
    background: $background;
    color: $foreground;
}

#match-count {
    width: auto;
    padding: 0 2;
    color: $text-muted;
}

#sysinfo {
    width: auto;
    max-width: 40;
    padding: 0 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#sysinfo:hover {
    color: $text;
}

/* Trzy panele jak w linutil: kategorie, lista, opis. Odstep miedzy nimi,
   zeby kazdy czytal sie jako osobna karta. */

#workspace {
    height: 1fr;
    padding: 0 1;
}

#sidebar, #tasks, #detail {
    border: round $panel;
    border-title-color: $text-accent;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    background: $surface;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $panel;
    scrollbar-color-hover: $btn-hover;
    scrollbar-color-active: $primary;
}

#sidebar:focus, #tasks:focus, #detail:focus {
    border: round $accent;
}

#sidebar {
    width: 20;
    height: 100%;
    margin-right: 1;
    padding: 0;
}

/* Aktywna kategoria jest widoczna takze bez fokusu; fokus ja rozjasnia. */

#sidebar > .option-list--option-highlighted {
    background: $btn-bg;
}

#sidebar:focus > .option-list--option-highlighted {
    background: $primary 25%;
}

#sidebar > .option-list--option-hover {
    background: $btn-hover 50%;
}

#tasks {
    width: 3fr;
    min-width: 36;
    height: 100%;
    margin-right: 1;
    padding: 0 1;
}

#detail {
    width: 2fr;
    min-width: 28;
    overflow-x: hidden;
    padding: 1 2;
}

#tasks > .option-list--option-hover {
    background: $btn-hover 50%;
}

/* Widoczne puste pudelko to "niezaznaczone", niebieski X to "zaznaczone".
   Tlo pudelka jest zawsze takie samo, zeby ruch kursora nie wygladal jak
   zmiana stanu. */

#tasks > .selection-list--button,
#tasks > .selection-list--button-highlighted {
    color: $btn-bg;
    background: $btn-bg;
}

#tasks > .selection-list--button-selected,
#tasks > .selection-list--button-selected-highlighted {
    color: $toggle-on;
    background: $btn-bg;
}

/* Pasek akcji: jedna linia, glowna akcja w kolorze sukcesu. */

#actionbar {
    height: 1;
    background: $panel;
    padding: 0 1;
}

#actionbar Button {
    width: auto;
    height: 1;
    margin: 0 1 0 0;
    padding: 0 2;
    border: none;
    background: $btn-bg;
    color: $foreground;
}

#actionbar Button:hover {
    background: $btn-hover;
}

#actionbar #act-run {
    background: $success;
    color: auto 90%;
    text-style: bold;
    padding: 0 3;
}

#actionbar #act-run:hover {
    background: $success 80%;
}

/* Zgaszony, dopoki nie ma czego uruchomic; zapala sie z pierwszym zaznaczeniem. */

#actionbar #act-run:disabled {
    background: $btn-bg;
    color: $text-muted;
}

#actionbar #act-dry.-live {
    color: $text-warning;
    text-style: bold;
}

/* Konsola: ukryta do pierwszego uruchomienia. */

#console {
    height: 14;
}

#statusbar {
    height: 1;
    background: $panel;
    padding: 0 2;
}

#status-mode {
    width: auto;
}

#status-count {
    width: 1fr;
    padding-left: 3;
    color: $text-muted;
}

#progress {
    width: 34;
}

#log {
    height: 1fr;
    border: round $panel;
    border-title-color: $text-accent;
    border-title-style: bold;
    background: $surface;
    margin: 0 1;
    padding: 0 1;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-color: $panel;
    scrollbar-color-hover: $btn-hover;
    scrollbar-color-active: $primary;
}

/* Okna modalne */

PlanScreen, PromptScreen, SummaryScreen, SystemScreen, HelpScreen, RestoreScreen, WelcomeScreen {
    align: center middle;
    background: $background 60%;
}

#plan-dialog, #summary-dialog, #system-dialog, #help-dialog {
    width: 100;
    max-width: 90%;
    height: 34;
    max-height: 90%;
    background: $surface;
    border: round $accent;
    padding: 1 2;
}

#prompt-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    background: $surface;
    border: round $accent;
    padding: 1 2;
}

#plan-title, #summary-title, #system-title, #help-title, #prompt-title {
    text-style: bold;
    color: $text-accent;
    width: 100%;
}

#plan-mode {
    width: 100%;
    margin-bottom: 1;
}

#plan-mode.dry {
    color: $text-warning;
}

#plan-mode.live {
    color: $text-success;
}

#plan-body, #summary-body, #system-body, #help-body {
    height: 1fr;
    border: round $panel;
    padding: 0 1;
    margin-bottom: 1;
}

#plan-buttons, #prompt-buttons {
    height: auto;
    align-horizontal: right;
}

#plan-buttons Button, #prompt-buttons Button {
    margin-left: 2;
}

#prompt-label {
    color: $text-muted;
    margin-bottom: 1;
}

#prompt-error {
    height: 1;
    margin-bottom: 1;
}

#summary-dialog Button, #system-dialog Button, #help-dialog Button {
    width: 100%;
}

#restore-dialog {
    width: 90;
    max-width: 90%;
    height: 30;
    max-height: 90%;
    background: $surface;
    border: round $accent;
    padding: 1 2;
}

#restore-title {
    text-style: bold;
    color: $text-accent;
    width: 100%;
}

#restore-intro {
    color: $text-muted;
    width: 100%;
    margin-bottom: 1;
}

#restore-sessions {
    height: 8;
    border: round $panel;
    margin-bottom: 1;
}

#restore-files {
    height: 1fr;
    border: round $panel;
    padding: 0 1;
    margin-bottom: 1;
}

#restore-buttons {
    height: auto;
    align-horizontal: right;
}

#restore-buttons Button {
    margin-left: 2;
}

#welcome-dialog {
    width: 62;
    max-width: 90%;
    height: auto;
    background: $surface;
    border: round $accent;
    padding: 1 2;
}

#welcome-content {
    margin-bottom: 1;
}

#welcome-dialog Button {
    width: 100%;
}
