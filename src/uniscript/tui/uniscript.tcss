/* Palety siedza w app.py (DARK_THEME, LIGHT_THEME). Tutaj tylko uklad i ramki,
   wszystkie kolory przez zmienne motywu, zeby dzialalo na jasnym tle tak samo. */

Screen {
    background: $background;
}

#workspace {
    height: 1fr;
}

/* Pasek filtra: jedna linia nad lista, bez wlasnej ramki, zeby nie mnozyc
   obwodek nad ramka listy. */

#filterbar {
    height: 1;
    background: $panel;
    padding: 0 2;
}

#search {
    width: 1fr;
    height: 1;
    padding: 0;
    border: none;
    background: transparent;
    color: $foreground;
}

#search:focus {
    background: transparent;
    color: $foreground;
    text-style: bold;
}

#match-count {
    width: auto;
    padding-left: 2;
    color: $text-muted;
}

/* Panele: ta sama ramka, ta sama reakcja na fokus. */

#tasks, #detail {
    border: round $primary 40%;
    border-title-color: $text-primary;
    border-title-style: bold;
    background: $surface;
}

#tasks:focus, #detail:focus {
    border: round $accent;
}

#tasks {
    height: 3fr;
    min-height: 8;
    padding: 0 1;
    scrollbar-size-vertical: 1;
    border-subtitle-color: $text-muted;
}

/* Widoczne puste pudelko to "niezaznaczone", zielony X to "zaznaczone". Tlo
   pudelka jest zawsze takie samo, zeby ruch kursora nie wygladal jak zmiana
   stanu, a kolor X w stanie pustym zlewa sie z tlem pudelka. */

#tasks > .selection-list--button,
#tasks > .selection-list--button-highlighted {
    color: $panel-lighten-1;
    background: $panel-lighten-1;
}

#tasks > .selection-list--button-selected,
#tasks > .selection-list--button-selected-highlighted {
    color: $text-success;
    background: $panel-lighten-1;
}

#detail {
    height: 2fr;
    min-height: 8;
    overflow-x: hidden;
    padding: 0 2;
    scrollbar-size-vertical: 1;
}

/* Konsola: ukryta do pierwszego uruchomienia, wiec ma wlasny naglowek statusu. */

#console {
    height: 14;
}

#statusbar {
    height: 1;
    background: $panel;
    padding: 0 2;
}

#status-mode {
    width: auto;
}

#status-count {
    width: 1fr;
    padding-left: 3;
    color: $text-muted;
}

#progress {
    width: 34;
}

#log {
    height: 1fr;
    border: round $primary 40%;
    border-title-color: $text-primary;
    border-title-style: bold;
    background: $surface;
    padding: 0 1;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
}

/* Okna modalne */

PlanScreen, PromptScreen, SummaryScreen, SystemScreen, HelpScreen {
    align: center middle;
    background: $background 60%;
}

#plan-dialog, #summary-dialog, #system-dialog, #help-dialog {
    width: 100;
    max-width: 90%;
    height: 34;
    max-height: 90%;
    background: $surface;
    border: round $accent;
    padding: 1 2;
}

#prompt-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    background: $surface;
    border: round $accent;
    padding: 1 2;
}

#plan-title, #summary-title, #system-title, #help-title, #prompt-title {
    text-style: bold;
    color: $text-accent;
    width: 100%;
}

#plan-mode {
    width: 100%;
    margin-bottom: 1;
}

#plan-mode.dry {
    color: $text-warning;
}

#plan-mode.live {
    color: $text-success;
}

#plan-body, #summary-body, #system-body, #help-body {
    height: 1fr;
    border: round $primary 40%;
    padding: 0 1;
    margin-bottom: 1;
}

#plan-buttons, #prompt-buttons {
    height: auto;
    align-horizontal: right;
}

#plan-buttons Button, #prompt-buttons Button {
    margin-left: 2;
}

#prompt-label {
    color: $text-muted;
    margin-bottom: 1;
}

#prompt-error {
    height: 1;
    margin-bottom: 1;
}

#summary-dialog Button, #system-dialog Button, #help-dialog Button {
    width: 100%;
}
