#!/usr/bin/env bash
# Runs uniscript, creating a virtual environment with Textual when needed.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
VENV="$DATA_HOME/uniscript/venv"
REQUIREMENTS="$SCRIPT_DIR/requirements.txt"
STAMP="$VENV/.requirements-stamp"

die() {
    printf 'uniscript: %s\n' "$1" >&2
    exit 1
}

find_python() {
    local candidate
    for candidate in python3.14 python3.13 python3.12 python3.11 python3; do
        command -v "$candidate" >/dev/null 2>&1 || continue
        if "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    return 1
}

requirements_stamp() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$REQUIREMENTS" | cut -d' ' -f1
    else
        wc -c <"$REQUIREMENTS" | tr -d ' '
    fi
}

venv_hint() {
    if command -v apt-get >/dev/null 2>&1; then
        printf '  sudo apt-get install python3-venv\n' >&2
    elif command -v dnf >/dev/null 2>&1; then
        printf '  sudo dnf install python3-libs\n' >&2
    fi
}

if [ "${UNISCRIPT_SYSTEM_PYTHON:-0}" = "1" ]; then
    PYTHON="$(find_python)" || die 'no python 3.11 or newer was found'
    exec env PYTHONPATH="$SCRIPT_DIR/src${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON" -m uniscript "$@"
fi

if [ ! -x "$VENV/bin/python" ]; then
    PYTHON="$(find_python)" || die 'no python 3.11 or newer was found'
    printf 'uniscript: creating the environment in %s\n' "$VENV" >&2
    mkdir -p "$(dirname "$VENV")"
    if ! "$PYTHON" -m venv "$VENV"; then
        printf 'uniscript: the environment could not be created. The venv module is missing:\n' >&2
        venv_hint
        exit 1
    fi
fi

WANT="$(requirements_stamp)"
if [ ! -f "$STAMP" ] || [ "$(cat "$STAMP")" != "$WANT" ]; then
    printf 'uniscript: installing the dependencies (textual)\n' >&2
    if ! "$VENV/bin/python" -m pip install --quiet --upgrade -r "$REQUIREMENTS"; then
        die 'installing the dependencies failed, check your network connection'
    fi
    printf '%s' "$WANT" >"$STAMP"
fi

exec env PYTHONPATH="$SCRIPT_DIR/src${PYTHONPATH:+:$PYTHONPATH}" \
    "$VENV/bin/python" -m uniscript "$@"
